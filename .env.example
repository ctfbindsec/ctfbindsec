# Copy to .env and fill in. NEVER commit .env.

# HTX USDT-M perpetuals API
# Create at https://www.htx.com/en-us/apiManagement
# Permissions: Read + Trade. Withdraw MUST be OFF.
# IP-whitelist your machine's public IP (curl https://api.ipify.org).
HTX_ACCESS_KEY=
HTX_SECRET_KEY=
HTX_USDT_M_HOST=api.hbdm.com

# Telegram bot for HITL approvals
# 1. /newbot to @BotFather, get token
# 2. /start your bot, then visit https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Anthropic API (optional; v0 does not require it)
# Used only by the optional Haiku tick-summary feature, default off.
ANTHROPIC_API_KEY=

# Operating parameters (tier -1 micro experimental). Override here if needed.
CTFQUANT_NAV_USD=200
CTFQUANT_TIER=tier_minus_1
CTFQUANT_DRY_RUN=true
CTFQUANT_LOG_LEVEL=INFO
CTFQUANT_DB_PATH=./var/state.db
